# EvSnap (ElectroLens AI) — Environment Variables
# Copy this file to .env or .env.local for local development.
# On Vercel: configure in Project Settings -> Environment Variables.

# Google Gemini API Key (Strictly Server-Side — NEVER expose with VITE_* prefix)
# Get a free key at: https://aistudio.google.com/apikeys
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Recommended active Flash model (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional fallback recognized by the Google GenAI SDK:
# GOOGLE_API_KEY=your_gemini_api_key_here
